{
    "type": "screen",
    "animations": [
        {
            "field": "opacity",
            "func": "linear",
            "repeats": 0,
            "duration": 0.25,
            "relative": false,
            "delay": 0,
            "keyframes": {
                "0": 0,
                "30": 0,
                "100": 255
            }
        }
    ],
    "childrens": [
        {
            "type": "image",
            "id": "_backgroundImage",
            "parameters": {
                "folderName": "PKD_TreasureChest",
                "keepAspect": true,
                "useAspectSize": true
            },
            "bindings": {
                "size": {
                    "width": "612hdp",
                    "height": "468hdp"
                },
                "position": {
                    "x": "center",
                    "y": "center"
                },
                "image": "$backgroundImageName"
            },
            "childrens": [
                {
                    "type": "image",
                    "parameters": {
                        "folderName": "PKD_TreasureChest",
                        "imageName": "bg",
                        "keepAspect": false,
                        "useAspectSize": false
                    },
                    "bindings": {
                        "size": {
                            "width": "255hdp",
                            "height": "185hdp"
                        },
                        "position": {
                            "x": "center",
                            "y": "center"
                        }
                    },
                    "childrens": [
                        {
                            "type": "list",
                            "id": "_itemsList",
                            "constants": {
                                "minVisibleCelsCount": 9
                            },
                            "parameters": {
                                "maxCols": 3,
                                "isHaveSelectionEffect": false,
                                "selectionEffects": ["glow;distance:10;outerStrength:3"],
                                "scaleItemsWidth": false,
                                "scaleItemsHeight": false,
                                "isDrawDefaultItemBack": false,
                                "defaultItemHeight": 0,
                                "backgroundType": 2,
                                "itemsPadding": 5,
                                "isHaveInOutAnimation": false,
                                "isHorizontal": false,
                                "inAnimation": "field:x;duration:0.15;keyframes:0=0,100=4",
                                "outAnimation": "field:x;duration:0.15;keyframes:0=4,100=0",
                                "isPlayOkSound": false,
                                "isPlayCursorSound": true
                            },
                            "bindings": {
                                "size": {
                                    "width": "98%",
                                    "height": "96%"
                                },
                                "position": {
                                    "x": "center + 5hdp",
                                    "y": "center + 8hdp"
                                }
                            }
                        },
                        {
                            "type": "plane",
                            "parameters": {
                                "folderName": "PKD_TreasureChest",
                                "imageName": "frame",
                                "margins": 42
                            },
                            "bindings": {
                                "size": {
                                    "width": "108%",
                                    "height": "108%"
                                },
                                "position": {
                                    "x": "center",
                                    "y": "center"
                                }
                            }
                        },
                        {
                            "type": "image",
                            "parameters": {
                                "folderName": "PKD_TreasureChest",
                                "imageName": "itemNameBackground",
                                "keepAspect": true,
                                "useAspectSize": true
                            },
                            "bindings": {
                                "size": {
                                    "width": "120%",
                                    "height": "58hdp"
                                },
                                "position": {
                                    "x": "center",
                                    "y": "top - height - 8hdp"
                                }
                            },
                            "childrens": [
                                {
                                    "type": "textPro",
                                    "id": "_itemNameText",
                                    "parameters": {
                                        "alignment": "center",
                                        "font": { "size": 15 },
                                        "outline": { "color": "#000", "width": 2 },
                                        "textColor": "#FFFFFF",
                                        "text": "",
                                        "multiline": false,
                                        "verticalCentered": true,
                                        "verticalAlignment": "center"
                                    },
                                    "bindings": {
                                        "size": {
                                            "width": "100%",
                                            "height": "20hdp"
                                        },
                                        "position": {
                                            "x": "center",
                                            "y": "center"
                                        },
                                        "fontSize": "15hdp"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "imageButton",
                            "id": "_takeAllButton",
                            "createIf": "$isTakeAllButtonAvailable",
                            "parameters": {
                                "imageName": "takeAllButton_00",
                                "folderName": "PKD_TreasureChest",
                                "hoverImageName": "takeAllButton_01",
                                "clickSe": "Cursor1"
                            },
                            "bindings": {
                                "size": {
                                    "width": "54hdp",
                                    "height": "54hdp"
                                },
                                "position": {
                                    "x": "-14hdp",
                                    "y": "end + 8hdp"
                                }
                            }
                        },
                        {
                            "type": "imageButton",
                            "id": "_closeButton",
                            "parameters": {
                                "imageName": "closeButton_00",
                                "folderName": "PKD_TreasureChest",
                                "hoverImageName": "closeButton_01",
                                "clickSe": "Cursor1"
                            },
                            "bindings": {
                                "size": {
                                    "width": "54hdp",
                                    "height": "54hdp"
                                },
                                "position": {
                                    "x": "right + 14hdp",
                                    "y": "end + 8hdp"
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}